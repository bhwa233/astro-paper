    "@types/node": "^26.1.2",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^1.7.0",
    "html-minifier-terser": "^7.2.0",
    "pagefind": "^1.5.2",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
