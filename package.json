    "mdast-util-to-string": "^4.0.0",
    "qrcode-generator": "^2.0.4",
    "sanitize-html": "^2.17.6",
    "satori": "^0.26.0",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "yaml": "^2.8.3",
    "zod": "^4.4.3"
