    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@mozilla/readability": "^0.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "adm-zip": "^0.6.0",
    "ai": "^7.0.66",
    "astro": "^7.2.3",
    "cac": "^7.0.0",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.10.1",
    "feedsmith": "^2.9.6",
