  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist",
    "search:index": "pagefind --site dist --output-path public/pagefind",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "typecheck": "astro sync && tsc --noEmit",
    "test:blog": "node --import tsx --test \"tests/*.test.ts\"",
    "test:wechat": "vitest run",
    "wechat": "node --import tsx scripts/wechat/src/cli.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint . && node --import tsx scripts/check_conventions.ts",
    "check:conventions": "node --import tsx scripts/check_conventions.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.44",
