---
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";
import { tplStr } from "@/i18n/format";
import { getLocaleLangTag } from "@/utils/localeMeta";

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
  readingTime?: number;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
  readingTime,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const localeTag = getLocaleLangTag(locale);

const isModified = modDatetime && modDatetime > pubDatetime;

// 时区只影响展示：Intl.DateTimeFormat 的 timeZone 已经完成换算，
// 时间点本身（datetime 属性用的 ISO 串）与时区无关，无需再套一层库。
const displayTimezone = postTimezone ?? config.site.timezone;
const datetime = new Date(isModified ? modDatetime : pubDatetime);

const date = new Intl.DateTimeFormat(localeTag, {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: displayTimezone,
}).format(datetime);
---

<div
  class:list={["text-muted-foreground flex items-center gap-x-2", className]}
>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  {
    isModified && (
      <span
        data-updated-label
        class:list={["text-sm", { "sm:text-base": size === "lg" }]}
      >
        {t.post.updatedAt}:
      </span>
    )
  }
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={datetime.toISOString()}
  >
    {date}
  </time>
  {
    readingTime != null && (
      <>
        <span aria-hidden="true" data-reading-sep>
          |
        </span>
        <span
          data-reading-time
          class:list={["text-sm", { "sm:text-base": size === "lg" }]}
        >
          {tplStr(t.post.readingTime, { min: readingTime })}
        </span>
      </>
    )
  }
</div>
