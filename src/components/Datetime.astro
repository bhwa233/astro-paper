---
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import IconClock from "@/assets/icons/IconClock.svg";
import IconFileText from "@/assets/icons/IconFileText.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";
import { tplStr } from "@/i18n/format";
import { formatCompactDate } from "@/utils/formatCompactDate";

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
  readingTime?: number;
  wordCount?: number;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
  readingTime,
  wordCount,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const isModified = modDatetime && modDatetime > pubDatetime;

// 时区只影响展示：Intl.DateTimeFormat 的 timeZone 已经完成换算，
// 时间点本身（datetime 属性用的 ISO 串）与时区无关，无需再套一层库。
const displayTimezone = postTimezone ?? config.site.timezone;
const datetime = new Date(isModified ? modDatetime : pubDatetime);

const date = formatCompactDate(datetime, displayTimezone);

// 时长旁只放短版「8 分钟」，完整的「8 分钟阅读」交给 sr-only 与悬停提示。
const readingLabel =
  readingTime != null ? tplStr(t.post.readingTime, { min: readingTime }) : "";
const readingShortLabel =
  readingTime != null
    ? tplStr(t.post.readingTimeShort, { min: readingTime })
    : "";
// 字数直接显示完整值，视觉文本已经等于完整说法，不再另写一份 sr-only。
const wordCountLabel =
  wordCount != null ? tplStr(t.post.wordCount, { count: wordCount }) : "";

const textSize = ["text-sm", size === "lg" ? "sm:text-base" : ""];
const iconSize = [
  "inline-block size-6 min-w-5.5",
  size === "sm" ? "scale-90" : "",
];
---

<div
  class:list={["text-muted-foreground flex items-center gap-x-3", className]}
>
  <span class="flex items-center gap-x-1.5">
    <IconCalendar class:list={iconSize} />
    <time class:list={textSize} datetime={datetime.toISOString()}>
      {date}
    </time>
  </span>
  {
    readingTime != null && (
      <span class="flex items-center gap-x-1.5" title={readingLabel}>
        <IconClock class:list={iconSize} />
        <span class:list={textSize} aria-hidden="true" data-reading-time>
          {readingShortLabel}
        </span>
        <span class="sr-only" data-reading-time-label>
          {readingLabel}
        </span>
      </span>
    )
  }
  {
    wordCount != null && (
      <span class="flex items-center gap-x-1.5" title={wordCountLabel}>
        <IconFileText class:list={iconSize} />
        <span class:list={textSize} data-word-count>
          {wordCountLabel}
        </span>
      </span>
    )
  }
</div>
