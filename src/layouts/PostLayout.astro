---
import Layout from "./Layout.astro";
import type { LocaleAlternate } from "@/utils/localeAlternates";
import {
  buildBreadcrumbSchema,
  buildItemListSchema,
  type SchemaLink,
} from "@/utils/structuredData";
import config from "@/config";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  localeAlternates?: LocaleAlternate[];
  pubDatetime?: Date;
  modDatetime?: Date | null;
  /** 日报正文的条目锚点。给够数量才发 ItemList，随笔类文章的两三个小标题不算清单。 */
  sections?: SchemaLink[];
  /**
   * 文章页的层级。这里没有可见的面包屑（用的是返回按钮），但文章页才是搜索结果里
   * 最会展示面包屑的页面，所以标记单独给。
   */
  breadcrumb?: SchemaLink[];
};

const { site } = config;

const {
  title,
  description,
  ogImage,
  canonicalURL,
  localeAlternates,
  pubDatetime,
  modDatetime,
  sections = [],
  breadcrumb = [],
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title ?? site.title,
  image: ogImage,
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: site.author,
      ...(site.profile && { url: site.profile }),
    },
  ],
};
---

<Layout
  {title}
  {description}
  {ogImage}
  {canonicalURL}
  {localeAlternates}
  ogType="article"
>
  <Fragment slot="head">
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />

    {
      breadcrumb.length > 0 && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(buildBreadcrumbSchema(breadcrumb))}
        />
      )
    }

    {
      sections.length >= 3 && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(buildItemListSchema(sections))}
        />
      )
    }
  </Fragment>

  <slot />
</Layout>
