---
import type { GetStaticPathsOptions } from "astro";
import { addLocaleParam, getNonDefaultLocaleStaticPaths } from "@/i18n/locales";
import { getPaginatedPostPaths } from "@/utils/localeStaticPaths";
import Page from "../../posts/[...page].astro";

export async function getStaticPaths(options: GetStaticPathsOptions) {
  return getNonDefaultLocaleStaticPaths(async locale =>
    addLocaleParam(locale, await getPaginatedPostPaths(locale, options))
  );
}

type PageProps = Parameters<typeof Page>[0];
const pageProps = Astro.props as PageProps;
---

<Page {...pageProps} />
